<Window x:Class="SagaIngenieria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="SAGA Ingeniería V2.0 | Control de Amortiguadores" Height="768" Width="1366"
        Background="#1E1E1E" Foreground="White" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
            <StackPanel Margin="15">
                <TextBlock Text="SAGA SENSORS" FontSize="24" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,20"/>

                <GroupBox Header="Conexión" Foreground="#CCCCCC" BorderBrush="#3F3F46" Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="Puerto COM" Margin="0,5,0,0" Foreground="Gray"/>
                        <ComboBox x:Name="CmbPuertos" Height="30" Margin="0,2"/>
                        <Button x:Name="BtnConectar" Content="CONECTAR EQUIPO" Height="40" Margin="0,10,0,0"
                                Background="#2D2D30" Foreground="White" Click="BtnConectar_Click"
                                FontWeight="SemiBold" BorderBrush="#007ACC"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Parámetros de Ensayo" Foreground="#CCCCCC" BorderBrush="#3F3F46" Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="Velocidad (Hz)" Foreground="Gray"/>
                        <TextBox x:Name="TxtVelocidad" Text="1.0" Height="30" FontSize="16" FontWeight="Bold" 
                                 Background="#333337" Foreground="White" BorderBrush="#3F3F46" Padding="5"/>

                        <TextBlock Text="Ciclos / Duración" Foreground="Gray" Margin="0,10,0,0"/>
                        <TextBox x:Name="TxtDuracion" Text="Automático" IsReadOnly="True" Height="30" 
                                 Background="#333337" Foreground="#888888" BorderBrush="#3F3F46" Padding="5"/>
                    </StackPanel>
                </GroupBox>

                <Button x:Name="BtnIniciar" Content="▶ INICIAR ENSAYO" Height="60" Margin="0,10"
                        Background="#107C10" Foreground="White" FontSize="16" FontWeight="Bold"
                        Click="BtnIniciar_Click" IsEnabled="False"/>

                <Button x:Name="BtnDetener" Content="⏹ DETENER MOTOR" Height="40" Margin="0,5"
                        Background="#C50F1F" Foreground="White" FontWeight="Bold"
                        Click="BtnDetener_Click" IsEnabled="False"/>
                <Button Content="💾 GUARDAR ENSAYO" Height="40" Margin="0,5"
                        Background="#007ACC" Foreground="White" FontWeight="Bold"
                        Click="BtnGuardar_Click" />

                <TextBlock Text="Registro de Eventos" Margin="0,20,0,5" Foreground="Gray"/>
                <ListBox x:Name="ListLog" Height="150" Background="#1E1E1E" Foreground="#AAAAAA" 
                         BorderThickness="0" FontSize="11" FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="Fuerza vs Tiempo" GroupName="GraphMode" IsChecked="True" Foreground="White" Margin="10,0" Checked="GraphMode_Changed"/>
                <RadioButton Content="Fuerza vs Posición" GroupName="GraphMode" Foreground="White" Margin="10,0" Checked="GraphMode_Changed"/>
                <RadioButton Content="Fuerza vs Velocidad" GroupName="GraphMode" Foreground="White" Margin="10,0" Checked="GraphMode_Changed"/>
                <CheckBox x:Name="ChkFiltro" Content="Aplicar Filtro Fourier (10Hz)" IsChecked="True" Foreground="#007ACC" Margin="20,0" FontWeight="Bold"/>
            </StackPanel>

            <scott:WpfPlot x:Name="WpfPlot1" Grid.Row="1"/>

            <Border x:Name="OverlayCarga" Grid.Row="1" Background="#AA000000" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="ADQUIRIENDO DATOS..." FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Por favor espere, procesando buffer de hardware" FontSize="14" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,10"/>
                </StackPanel>
            </Border>
        </Grid>

        <StatusBar Grid.Row="1" Grid.ColumnSpan="2" Background="#007ACC" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="TxtEstado" Text="Listo para conectar" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="PrgEnsayo" Width="200" Height="15" Value="0" Maximum="100" Background="#1E1E1E" Foreground="White"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>